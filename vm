#!/bin/bash
# One headless macOS guest for UI checks of a Mac app: agents drive the app in
# the guest with agent-desktop and record the guest screen, so the host's
# display, mouse and keyboard stay free and a locked host screen does not stop
# the run. People watch or drive the same guest in a browser with voxl. See
# README.md.
#
#   vm up [--display WxH] [--appearance dark|light] [--locale ll_CC]
#                              create (first time), provision, boot headless, set up;
#                              the flags fix the guest's screen (points, HiDPI), look and
#                              language, and stay set for later vm up
#   vm down                    shut the guest down
#   vm save [name]             save the running guest's memory and disks, and stop it
#   vm restore [name]          resume a saved guest where it was (cold boot if it can't)
#   vm prepare [--rebuild]     build the set-up guest that new guests copy
#   vm status                  guest state, IP, host lock, guest power/lock settings
#   vm ssh [cmd...]            a shell, or one command, in the guest
#   vm install <App.app> [build label]
#   vm run [--env K=V]... [-- args...]  start the installed app, wait for its window
#   vm quit                    quit the installed app (only that copy)
#   vm forward-host <name>     resolve <name> to the host in the guest's /etc/hosts
#   vm ad <args...>            agent-desktop in the guest
#   vm record start [secs]     record the guest screen (default 60 s max)
#   vm record stop <dir> [name]  stop and pull the .mov into <dir>, with fps, and the
#                              vm ad calls made meanwhile lined up with its frames
#   vm shot <dir> [name]       one guest screenshot into <dir>
#   vm vsync [secs]            guest display refreshes per second (compositing check)
#   vm view [--control] [--remote]  open the guest desktop in a browser (voxl);
#                              --control holds the guest for the person: vm ad input,
#                              run, quit and install exit 3 until vm view or vm view stop
#   vm view stop               stop voxl and its forwards
#
# Installed with Homebrew the command is agent-vm.
#
# VM_HOME (default <repo>/.vm in a checkout, ~/.agent-vm installed) holds the restore image, guests, ssh key and logs.
# VM_NAME (default agent-vm) names the guest; VM_CPU, VM_MEMORY_MB, VM_DISK_GB.
# New guests copy a prepared guest with Homebrew and voxl (built once by vm
# prepare); VM_BREW=0 starts from the bare install and skips Homebrew.
set -euo pipefail

# Resolve symlinks: Homebrew links bin/agent-vm to this file in libexec.
here=$(dirname "$(readlink -f "$0")")
# A checkout keeps its state beside the code; an installed copy in ~/.agent-vm.
if [ -d "$here/.git" ]; then VM_HOME=${VM_HOME:-$here/.vm}; else VM_HOME=${VM_HOME:-$HOME/.agent-vm}; fi
VM_NAME=${VM_NAME:-agent-vm}
VM_CPU=${VM_CPU:-4}
VM_MEMORY_MB=${VM_MEMORY_MB:-8192}
VM_DISK_GB=${VM_DISK_GB:-80}
if [ -x "$here/agent-vm-runner" ]; then RUNNER=${RUNNER:-$here/agent-vm-runner}
else RUNNER=${RUNNER:-$here/runner/.build/release/agent-vm-runner}; fi
VOXL_VERSION=${VOXL_VERSION:-0.3.4}
VIEW_PORT=${VIEW_PORT:-16901}
GUEST_USER=admin GUEST_PASS=admin
guests=$VM_HOME/guests
base=$guests/base.bundle
ready=$guests/ready.bundle
bundle=$guests/$VM_NAME.bundle
state=$bundle/agent-vm.state
JOB=dev.agent-vm.$VM_NAME
VIEW_JOB=$JOB.view

mkdir -p "$VM_HOME/ssh" "$VM_HOME/logs" "$VM_HOME/run" "$VM_HOME/ipsw" "$guests"
key=$VM_HOME/ssh/id_ed25519
[ -f "$key" ] || ssh-keygen -q -t ed25519 -N '' -C "$VM_NAME" -f "$key"

die() { echo "vm: $*" >&2; exit 1; }
log() { echo "vm: $*" >&2; }

exists() { [ -f "$bundle/config.json" ]; }
# A key of the guest's config.json; empty when unset.
conf() { python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2], ""))' "$bundle/config.json" "$1"; }
# Set keys in config.json: conf_set k=v... (an integer value is stored as one).
conf_set() {
  python3 -I - "$bundle/config.json" "$@" <<'PY3'
import json, sys
p = sys.argv[1]; c = json.load(open(p))
for kv in sys.argv[2:]:
    k, v = kv.split("=", 1); c[k] = int(v) if v.isdigit() else v
json.dump(c, open(p, "w"))
PY3
}
# The runner is started with the bundle's absolute path, which provision's
# running-guest guard matches too.
# The runner for this guest, booted or restored (run <bundle> --restore <state>).
runner_pat="agent-vm-runner run $bundle( |\$)"
running() { pgrep -f "$runner_pat" >/dev/null; }
done_step() { grep -qx "$1" "$state" 2>/dev/null; }
mark() { echo "$1" >> "$state"; }

# The guest's IP from the host's DHCP leases. The file drops leading zeros in
# each MAC byte and keeps old leases, so take the newest match.
ip_now() {
  python3 -I - "$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["mac"])' "$bundle/config.json")" <<'PY'
import re, sys
mac = ":".join(b.lstrip("0") or "0" for b in sys.argv[1].lower().split(":"))
try: text = open("/var/db/dhcpd_leases").read()
except OSError: sys.exit(1)
best = None
for block in re.findall(r"\{(.*?)\}", text, re.S):
    f = dict(re.findall(r"^\s*(\w+)=(.*)$", block, re.M))
    if f.get("hw_address", "").split(",", 1)[-1].lower() == mac:
        lease = int(f.get("lease", "0x0"), 16)
        if best is None or lease > best[0]: best = (lease, f["ip_address"])
if not best: sys.exit(1)
print(best[1])
PY
}
ip() {
  local i; for i in $(seq "${1:-5}"); do ip_now 2>/dev/null && return; sleep 1; done
  return 1
}

sshopts=(-i "$key" -o IdentitiesOnly=yes -o StrictHostKeyChecking=no
  -o UserKnownHostsFile="$VM_HOME/ssh/known_hosts" -o LogLevel=ERROR
  -o ConnectTimeout=5 -o ServerAliveInterval=10)
# Run in the guest. ssh's PATH lacks /usr/local/bin, where agent-desktop goes.
g() { ssh "${sshopts[@]}" "$GUEST_USER@$(ip)" 'export PATH=/usr/local/bin:/opt/homebrew/bin:$HOME/.cargo/bin:$PATH;' "$@"; }
q() { printf '%q ' "$@"; }                               # quote for the remote shell

# provision writes root-owned files onto the guest's disk, so it runs as root.
# An agent's shell can't answer a password prompt: fail now, not mid-run.
as_root() {
  if sudo -n true 2>/dev/null; then sudo -n "$@"
  elif [ -n "${SUDO_ASKPASS:-}" ]; then sudo -A "$@"
  else die "provisioning needs root on the host: run 'sudo -v' in this terminal, or set SUDO_ASKPASS, then rerun vm up"
  fi
}

restore_image() {
  local f; f=$(ls "$VM_HOME"/ipsw/*.ipsw 2>/dev/null | tail -1 || true)
  if [ -z "$f" ]; then
    local url; url=$("$RUNNER" ipsw-url)
    f=$VM_HOME/ipsw/$(basename "$url")
    log "downloading $(basename "$url") (about 25 GB; rerun to resume)"
    caffeinate -i curl -fL --retry 5 -C - -o "$f.part" "$url" >&2
    mv "$f.part" "$f"
  fi
  echo "$f"
}

# bootout returns before the job is gone, and bootstrap then fails with EIO.
job_reload() {
  launchctl bootout "gui/$(id -u)/$1" 2>/dev/null || true
  local i; for i in $(seq 50); do launchctl print "gui/$(id -u)/$1" >/dev/null 2>&1 || break; sleep 0.2; done
  launchctl bootstrap "gui/$(id -u)" "$2"
}

# A launchd job, not a child of this shell: it outlives the caller (an agent
# harness reaps its process group). ExitTimeOut leaves the guest time to shut
# down when the job is booted out.
# boot [--restore <state>]: start the runner as a launchd job.
boot() {
  local plist=$VM_HOME/run/$JOB.plist extra=""
  [ "${1:-}" = --restore ] && extra="<string>--restore</string><string>$2</string>"
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$JOB</string>
  <key>ProgramArguments</key><array>
    <string>$RUNNER</string><string>run</string><string>$bundle</string>$extra
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>ExitTimeOut</key><integer>120</integer>
  <key>StandardOutPath</key><string>$VM_HOME/logs/$VM_NAME-run.log</string>
  <key>StandardErrorPath</key><string>$VM_HOME/logs/$VM_NAME-run.log</string>
</dict></plist>
EOF
  job_reload "$JOB" "$plist"
  rm -f "$hold"
  [ -n "$extra" ] && return
  log "booting $VM_NAME"
  ip 180 >/dev/null || die "no IP after 180 s (see $VM_HOME/logs/$VM_NAME-run.log)"
  local i; for i in $(seq 90); do g true 2>/dev/null && return; sleep 2; done
  die "no ssh to the guest after 180 s"
}

shutdown_guest() {
  running || { launchctl bootout "gui/$(id -u)/$JOB" 2>/dev/null || true; return; }
  g "sudo shutdown -h now" >/dev/null 2>&1 || true
  local i; for i in $(seq 60); do running || break; sleep 2; done
  # The runner asks the guest to stop on the first TERM and stops it on the second.
  running && { pkill -TERM -f "$runner_pat"; sleep 20; }
  running && pkill -TERM -f "$runner_pat"
  launchctl bootout "gui/$(id -u)/$JOB" 2>/dev/null || true
}

# An APFS clone: instant, and it takes space only as the copies differ. The
# copy gets its own MAC and no viewer token; "keep" keeps the source's steps.
clone_from() {
  rm -rf "$bundle.tmp"
  cp -cR "$1" "$bundle.tmp"
  if [ "${2:-}" = keep ]; then grep -vx ready "$1/agent-vm.state" > "$bundle.tmp/agent-vm.state" || true
  else : > "$bundle.tmp/agent-vm.state"; fi
  rm -f "$bundle.tmp/voxl-token"
  python3 -I - "$bundle.tmp/config.json" <<'PY2'
import json, random, sys
p = sys.argv[1]; c = json.load(open(p))
c["mac"] = ":".join(["%02x" % ((random.randrange(256) | 2) & 0xfe)] + ["%02x" % random.randrange(256) for _ in range(5)])
json.dump(c, open(p, "w"))
PY2
  mv "$bundle.tmp" "$bundle"
}

# The prepared guest new guests copy: provisioned, set up, with Homebrew and
# voxl, shut down. Built once (about 10 min); --rebuild after updating
# agent-vm so new guests get the new provisioning.
cmd_prepare() {
  [ "${1:-}" = --rebuild ] && { VM_NAME=ready "$0" down >/dev/null 2>&1 || true; rm -rf "$ready"; }
  grep -qx ready "$ready/agent-vm.state" 2>/dev/null && { log "prepared guest is up to date"; return; }
  log "preparing the guest new guests copy (once, about 10 min)"
  VM_NAME=ready VM_BREW=1 "$0" up
  VM_NAME=ready "$0" ssh "VOXL_VERSION=$VOXL_VERSION /bin/bash -s" < "$here/guest/voxl-build.sh" ||
    die "voxl build in the prepared guest failed; see ~/vm/voxl-build.log there"
  VM_NAME=ready "$0" down
  echo ready >> "$ready/agent-vm.state"
}

# Each step is recorded in the bundle, so an interrupted vm up resumes.
cmd_up() {
  local display="" appearance="" locale=""
  while [ $# -gt 0 ]; do
    case $1 in
      --display) display=${2:?--display needs WxH}; shift 2
        [[ $display =~ ^[0-9]+x[0-9]+$ ]] || die "--display wants WxH in points, e.g. 1440x900" ;;
      --appearance) appearance=${2:?--appearance needs dark or light}; shift 2
        case $appearance in dark|light) ;; *) die "--appearance wants dark or light" ;; esac ;;
      --locale) locale=${2:?--locale needs a locale like de_DE}; shift 2
        [[ $locale =~ ^[a-z]{2,3}(_[A-Z]{2})?$ ]] || die "--locale wants a locale like de_DE" ;;
      *) die "usage: vm up [--display WxH] [--appearance dark|light] [--locale ll_CC]" ;;
    esac
  done
  [ -x "$RUNNER" ] || die "no runner at $RUNNER; run make runner"
  if ! exists; then
    if [ ! -f "$base/config.json" ] || ! grep -qx installed "$base/agent-vm.state" 2>/dev/null; then
      local img; img=$(restore_image)
      rm -rf "$base"
      log "installing macOS into $base (10-20 min)"
      caffeinate -i "$RUNNER" create "$base" "$img" --disk-gb "$VM_DISK_GB" --cpu "$VM_CPU" --memory-mb "$VM_MEMORY_MB"
      echo installed > "$base/agent-vm.state"
    fi
    # Copy the prepared guest when there is one to copy: it already has every
    # step below plus Homebrew and voxl. Otherwise start from the bare install.
    if [ "$VM_NAME" != ready ] && [ "${VM_BREW:-1}" = 1 ]; then
      grep -qx ready "$ready/agent-vm.state" 2>/dev/null || cmd_prepare
      clone_from "$ready" keep
      log "created $VM_NAME from the prepared guest"
    else
      clone_from "$base"
      log "created $VM_NAME from the base install"
    fi
  fi
  if ! done_step base; then
    running && die "$VM_NAME is running but not provisioned; vm down first"
    as_root env GUEST_USER=$GUEST_USER GUEST_PASS=$GUEST_PASS "$here/provision" base "$bundle" "$key.pub"
    mark base
  fi
  if ! done_step firstboot; then
    running || boot
    # sshd starts partway through firstboot.sh; wait for the whole script.
    local i; for i in $(seq 60); do g "test -f /Library/agent-vm/firstboot.done" 2>/dev/null && break; sleep 2; done
    g "test -f /Library/agent-vm/firstboot.done" || die "first-boot setup did not finish; see /var/log/agent-vm-firstboot.log in the guest"
    shutdown_guest
    mark firstboot
  fi
  if ! done_step tcc; then
    running && shutdown_guest
    as_root env GUEST_USER=$GUEST_USER "$here/provision" tcc "$bundle"
    mark tcc
  fi
  # The environment flags stick in config.json, so a later vm up keeps them.
  [ -n "$appearance" ] && conf_set appearance="$appearance"
  [ -n "$locale" ] && conf_set locale="$locale"
  if [ -n "$display" ]; then
    # The runner's display is fixed at boot: 2x the points, so the guest runs HiDPI.
    local w=$((2 * ${display%x*})) h=$((2 * ${display#*x}))
    if [ "$(conf width)x$(conf height)" != "${w}x$h" ]; then
      running && refuse_if_held "the display change"
      conf_set display="$display" width=$w height=$h
      running && { log "restarting $VM_NAME for the new display size"; shutdown_guest; }
    else conf_set display="$display"; fi
  fi
  running || boot
  # Autologin: the desktop belongs to the guest user before anything captures it.
  local i; for i in $(seq 60); do [ "$(g 'stat -f %Su /dev/console')" = "$GUEST_USER" ] && break; sleep 2; done
  cmd_setup
  if [ "${VM_BREW:-1}" = 1 ] && ! done_step brew; then
    log "installing the Command Line Tools and Homebrew in the guest (about 8 min; log ~/vm/brew-setup.log)"
    g "/bin/bash -s" < "$here/guest/brew-setup.sh" || die "Homebrew setup failed; see ~/vm/brew-setup.log in the guest"
    mark brew
  fi
  log "up at $(ip)"
}

# Idempotent guest setup: never sleep or lock, the recorder, agent-desktop.
cmd_setup() {
  g "/bin/sh -s" <<EOF
defaults -currentHost write com.apple.screensaver idleTime -int 0
defaults write com.apple.screensaver askForPassword -int 0
defaults write com.apple.screensaver askForPasswordDelay -int 0
sudo sysadminctl -screenLock off -password $GUEST_PASS >/dev/null 2>&1 || true
mkdir -p ~/Applications ~/vm/rec ~/vm/bin
EOF
  mkdir -p "$VM_HOME/bin"
  local t bin
  for t in vsync rec display; do
    # A release ships them built; a checkout compiles them from its source,
    # so a guest-bin left by make dist can't shadow an edit.
    bin=$here/guest-bin/$t
    if [ -d "$here/.git" ] || [ ! -x "$bin" ]; then
      bin=$VM_HOME/bin/$t
      [ "$bin" -nt "$here/guest/$t.swift" ] ||
        xcrun swiftc -O -target arm64-apple-macos14 -o "$bin" "$here/guest/$t.swift"
    fi
    g "cat > ~/vm/bin/$t && chmod +x ~/vm/bin/$t" < "$bin"
  done
  # agent-desktop: the host's copy, the launcher and its macOS helper (arm64).
  local ad; ad=$(command -v agent-desktop || true)
  [ -n "$ad" ] || die "agent-desktop is not on the host's PATH (brew install agent-desktop)"
  tar -C "$(dirname "$(readlink -f "$ad")")" -cf - agent-desktop agent-desktop-darwin-arm64 \
      agent-desktop-macos-helper agent-desktop-macos-helper-darwin-arm64 \
    | g "sudo mkdir -p /usr/local/lib/agent-desktop /usr/local/bin && sudo tar -C /usr/local/lib/agent-desktop -xf - \
         && sudo ln -sf /usr/local/lib/agent-desktop/agent-desktop /usr/local/bin/agent-desktop"
  setup_env
}

# The fixed environment vm up stored: display mode, appearance, locale. Apps
# read the locale when they start, so vm run picks it up; appearance and the
# display mode change live.
setup_env() {
  local display appearance locale args=()
  display=$(conf display); appearance=$(conf appearance); locale=$(conf locale)
  [ -n "$display" ] && args+=(--size "$display")
  [ -n "$appearance" ] && args+=(--appearance "$appearance")
  if [ ${#args[@]} -gt 0 ]; then
    local i; for i in 1 2 3 4 5; do g "~/vm/bin/display $(q "${args[@]}")" >/dev/null 2>&1 && break; sleep 2; done
    g "~/vm/bin/display $(q "${args[@]}")" | sed 's/^/guest /' >&2
  fi
  if [ -n "$locale" ]; then
    g "defaults write -g AppleLocale $(q "$locale") && defaults write -g AppleLanguages -array $(q "${locale/_/-}")"
    log "guest locale $locale (apps started from now on)"
  fi
}

cmd_down() {
  view_stop >/dev/null 2>&1 || true
  running || { log "not running"; return; }
  shutdown_guest
  log "down"
}

cmd_status() {
  local lock; lock=$(ioreg -n Root -d1 -a | grep -A1 CGSSessionScreenIsLocked | grep -c '<true/>' || true)
  echo "host screen locked: $([ "$lock" = 1 ] && echo yes || echo no)"
  if ! exists; then echo "vm: $VM_NAME not created"; return; fi
  echo "provisioned: $(tr '\n' ' ' < "$state" 2>/dev/null)"
  local sn; for sn in "$snaps"/*/state.vzvmsave; do
    [ -f "$sn" ] && echo "snapshot: $(basename "$(dirname "$sn")") saved $(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$sn"), state $(du -h "$sn" | cut -f1)"
  done
  if ! running; then echo "vm: $VM_NAME stopped"; return; fi
  echo "vm: $VM_NAME running at $(ip || echo '(no IP yet)')"
  if [ -f "$hold" ]; then echo "hold: a person has control since $(cat "$hold"); agent input refuses (exit $HELD)"; else echo "hold: none"; fi
  g "/bin/sh -s" <<'EOF'
echo "guest: macOS $(sw_vers -productVersion), console user $(stat -f %Su /dev/console)"
echo "autologin: $(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null || echo none)"
echo "screensaver idleTime: $(defaults -currentHost read com.apple.screensaver idleTime 2>/dev/null || echo unset)"
echo "screenLock: $(sysadminctl -screenLock status 2>&1 | sed 's/.*] //')"
pmset -g | awk '$1 ~ /^(sleep|displaysleep|disksleep)$/ {printf "pmset %s: %s\n", $1, $2}'
echo "guest locked: $(ioreg -n Root -d1 -a | grep -A1 CGSSessionScreenIsLocked | grep -c '<true/>')"
a=$(cat ~/Applications/.agent-vm-app 2>/dev/null); if [ -z "$a" ]; then echo "app: none installed"; elif pgrep -f "^$a/Contents/MacOS/" >/dev/null; then echo "app: $(basename "$a") running ($(cat ~/Applications/.agent-vm-build 2>/dev/null))"; else echo "app: $(basename "$a") not running"; fi
if pgrep -x voxl >/dev/null; then echo "voxl: running ($(cat ~/vm/voxl.mode 2>/dev/null))"; else echo "voxl: not running"; fi
EOF
}

cmd_ssh() { if [ $# = 0 ]; then ssh -t "${sshopts[@]}" "$GUEST_USER@$(ip)"; else g "$@"; fi; }

# The installed app's path in the guest; install records it.
app() { g "cat ~/Applications/.agent-vm-app 2>/dev/null" || true; }

cmd_install() {
  refuse_if_held install
  local src=${1:?usage: vm install <App.app> [build label]} label=${2:-} name
  [ -d "$src/Contents/MacOS" ] || die "$src is not an app bundle"
  name=$(basename "$src")
  [ -n "$label" ] || label="$name built $(stat -f '%Sm' -t '%Y-%m-%dT%H:%M' "$src/Contents/MacOS")"
  cmd_quit >/dev/null 2>&1 || true
  # tar keeps the bundle's symlinks; scp -r does not.
  g "rm -rf $(q "Applications/$name") && mkdir -p ~/Applications"
  tar -C "$(dirname "$src")" -cf - "$name" | g "tar -C ~/Applications -xf - && xattr -cr $(q "Applications/$name")"
  printf '%s\n' "$label" | g "cat > ~/Applications/.agent-vm-build"
  printf '%s\n' "/Users/$GUEST_USER/Applications/$name" | g "cat > ~/Applications/.agent-vm-app"
  log "installed: $label"
}

cmd_run() {
  refuse_if_held run
  local a envs=() args=() name
  a=$(app); [ -n "$a" ] || die "nothing installed; run vm install first"
  while [ $# -gt 0 ]; do
    case $1 in
      --env) envs+=(--env "${2:?--env needs K=V}"); shift 2 ;;
      --) shift; args=("$@"); break ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  cmd_quit >/dev/null 2>&1 || true
  g "open -n -a $(q "$a") ${envs[*]+$(q "${envs[@]}")} ${args[*]+--args $(q "${args[@]}")}"
  name=$(basename "$a" .app)
  local i; for i in $(seq 30); do
    g "agent-desktop list-windows --app $(q "$name")" 2>/dev/null | grep -q '"title"' && { log "$name window up"; return; }
    sleep 1
  done
  die "no $name window after 30 s"
}

cmd_quit() {
  refuse_if_held quit
  # Match the installed copy by path: another session's build of the same app
  # under another path keeps running.
  local a exe; a=$(app); [ -n "$a" ] || return 0
  exe="$a/Contents/MacOS/$(basename "$a" .app)"
  g "pkill -TERM -f $(q "^$exe") || exit 0; for i in 1 2 3 4 5; do pgrep -f $(q "^$exe") >/dev/null || exit 0; sleep 1; done; pkill -KILL -f $(q "^$exe"); true"
}

# A guest app that verifies a host service's TLS certificate reaches it under
# the certificate's own name: map that name to the guest's default gateway.
cmd_forward_host() {
  local name=${1:?usage: vm forward-host <hostname>}
  g "sudo /bin/sh -s" <<EOF
set -e
gw=\$(route -n get default | awk '/gateway:/ {print \$2}')
sed -i '' '/ $name\$/d' /etc/hosts
echo "\$gw $name" >> /etc/hosts
echo "$name -> \$gw"
EOF
}

# While a person drives the guest in voxl (vm view --control), agents give
# way: input refuses with exit 3 until they hand back with vm view or vm view
# stop. Reading the screen still works.
hold=$VM_HOME/run/$VM_NAME.hold
HELD=3
refuse_if_held() {
  [ -f "$hold" ] || return 0
  # A hold outlives nothing: a stopped guest has no person driving it.
  running || { rm -f "$hold"; return 0; }
  echo "vm: a person has control of $VM_NAME (vm view --control since $(cat "$hold")); $1 waits until they hand back with vm view or vm view stop" >&2
  exit $HELD
}

# agent-desktop verbs that only read; every other verb counts as input.
AD_VERBS=" snapshot find screenshot get is click double-click triple-click right-click type set-value clear focus select toggle check uncheck expand collapse scroll scroll-to press key-down key-up hover drag mouse-move mouse-click mouse-down mouse-up mouse-wheel launch close-app list-windows list-displays list-apps focus-window resize-window move-window minimize maximize restore list-surfaces open-system-surface list-notifications dismiss-notification dismiss-all-notifications notification-action clipboard-get clipboard-set clipboard-clear wait status permissions version batch skills session cursor-overlay trace help "
AD_READ=" snapshot find screenshot get is list-windows list-displays list-apps list-surfaces list-notifications clipboard-get wait status permissions version skills session trace help "

cmd_ad() {
  # The verb is the first argument agent-desktop knows as one; flags before
  # it can take values (--session s1). An unknown verb counts as input.
  local a verb=""
  for a in "$@"; do case $AD_VERBS in *" $a "*) verb=$a; break ;; esac; done
  case $AD_READ in *" ${verb:-?} "*) ;; *) refuse_if_held "agent-desktop ${verb:-input}" ;; esac
  # During a recording, stamp the call's start and end on the guest clock, so
  # vm record stop can line it up with the frames.
  local args; args=$(python3 -I -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@")
  g "if ps -o command= -p \$(cat ~/vm/rec/pid 2>/dev/null) 2>/dev/null | grep -q vm/bin/rec; then
       now() { perl -MTime::HiRes=time -e 'printf \"%.3f\", time'; }
       s=\$(now); agent-desktop $(q "$@"); rc=\$?; e=\$(now)
       printf '{\"start\":%s,\"end\":%s,\"rc\":%d,\"args\":%s}\\n' \$s \$e \$rc $(q "$args") >> ~/vm/rec/current.actions.jsonl
       exit \$rc
     fi
     agent-desktop $(q "$@")"
}

cmd_record() {
  case ${1:-} in
    start)
      local secs=${2:-60}
      # The guest pauses whenever the host sleeps; hold the host awake.
      nohup caffeinate -i -t $((secs + 30)) >/dev/null 2>&1 & echo $! > "$VM_HOME/run/caffeinate.pid"; disown
      g "rm -f ~/vm/rec/current.mov ~/vm/rec/current.ticks.json ~/vm/rec/current.actions.jsonl; nohup ~/vm/bin/rec ~/vm/rec/current.mov $secs ${REC_SIZE:-} \
         >~/vm/rec/rec.log 2>&1 </dev/null & echo \$! > ~/vm/rec/pid"
      local i; for i in $(seq 20); do
        g "grep -q '^recording' ~/vm/rec/rec.log" && break
        g "kill -0 \$(cat ~/vm/rec/pid) 2>/dev/null" || die "rec exited: $(g 'cat ~/vm/rec/rec.log')"
        sleep 0.5
      done
      g "grep -q '^recording' ~/vm/rec/rec.log" || die "rec has no frame yet: $(g 'cat ~/vm/rec/rec.log')"
      log "recording (max ${secs}s)"
      ;;
    stop)
      local dir=${2:?usage: vm record stop <dir> [name]} name=${3:-guest-$(date +%Y%m%d-%H%M%S)}
      mkdir -p "$dir"
      g "p=\$(cat ~/vm/rec/pid); kill -INT \$p 2>/dev/null; for i in \$(seq 30); do kill -0 \$p 2>/dev/null || break; sleep 0.5; done; ! kill -0 \$p 2>/dev/null" ||
        die "rec did not finish in 15 s"
      g "test -s ~/vm/rec/current.mov" || die "no recording: $(g 'cat ~/vm/rec/rec.log')"
      g "cat ~/vm/rec/current.mov" > "$dir/$name.mov"
      g "cat ~/vm/rec/current.ticks.json" > "$dir/$name.ticks.json"
      kill "$(cat "$VM_HOME/run/caffeinate.pid" 2>/dev/null)" 2>/dev/null || true
      if g "test -s ~/vm/rec/current.actions.jsonl"; then
        if g "cat ~/vm/rec/current.actions.jsonl" | actions_line_up "$dir/$name.ticks.json" > "$dir/$name.actions.json"
        then log "actions: $dir/$name.actions.json"
        else rm -f "$dir/$name.actions.json"; log "no actions file"; fi
      fi
      "$here/fps" "$dir/$name.mov" | tee "$dir/$name.fps.json"
      ;;
    *) die "usage: vm record start [secs] | stop <dir> [name]" ;;
  esac
}

# The vm ad calls made during a recording (JSON lines on stdin), lined up with
# its ticks: when each started and ended in the movie, and the first tick
# after its start that got a new frame from the display. The change happened
# between that tick and the one before, so it is reported as an interval.
# Any change on screen counts, so it is this action's only on a still screen.
actions_line_up() {
  python3 -I -c '
import json, sys
t = json.load(open(sys.argv[1]))
if "start_epoch" not in t:
    sys.exit("the guest rec predates the action log; vm setup updates it")
hz, ticks, t0 = t["hz"], t["ticks"], t["start_epoch"]
out = []
for line in sys.stdin:
    a = json.loads(line)
    start, end = a["start"] - t0, a["end"] - t0
    r = {"args": a["args"], "rc": a["rc"], "start_s": round(start, 3), "end_s": round(end, 3)}
    first = next((i for i in range(max(0, int(start * hz) + 1), len(ticks)) if ticks[i] == "1"), None)
    if first is not None:
        r["first_change_s"] = [round((first - 1) / hz, 3), round(first / hz, 3)]
        r["first_change_after_start_ms"] = [max(0, round(((first - 1) / hz - start) * 1000)), round((first / hz - start) * 1000)]
    else:
        r["first_change_s"] = None
    # Any change counts, a blinking caret or the menu bar clock too: how busy
    # the screen was over the second before says whether the first change
    # above is likely caused by this action.
    k = int(start * hz)
    r["fresh_ticks_in_second_before"] = ticks[max(0, k - int(hz)):max(0, k)].count("1")
    out.append(r)
json.dump({"start_epoch": t0, "hz": hz, "actions": out}, sys.stdout, indent=1)
print()' "$1"
}

# Snapshots: the runner's saved memory and device state, with APFS clones of
# the disks and config as they were when it was saved. The state is only valid
# against those disks, so restoring puts them back too, and one snapshot can be
# restored again and again. Clones share blocks until the disks diverge.
snaps=$bundle/snapshots
host_locked() { [ "$(ioreg -n Root -d1 -a | grep -A1 CGSSessionScreenIsLocked | grep -c '<true/>')" = 1 ]; }
recording() { g "ps -o command= -p \$(cat ~/vm/rec/pid 2>/dev/null) 2>/dev/null | grep -q vm/bin/rec" 2>/dev/null; }

cmd_save() {
  local name=${1:-default} log=$VM_HOME/logs/$VM_NAME-run.log pid off
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || die "snapshot names use letters, digits, . _ -"
  running || die "$VM_NAME is not running"
  refuse_if_held save
  recording && die "a recording is running; vm record stop first"
  "$RUNNER" can-save "$bundle" >/dev/null || die "this guest's configuration can't be saved"
  # The runner encrypts the state with a Secure Enclave key, which can't be
  # made while the host screen is locked.
  host_locked && die "the host screen is locked; saving needs it unlocked ($VM_NAME keeps running)"
  view_stop >/dev/null 2>&1 || true
  off=$(wc -c < "$log"); pid=$(pgrep -f "$runner_pat" | head -1)
  kill -USR1 "$pid"
  local i; for i in $(seq 240); do
    kill -0 "$pid" 2>/dev/null || break
    tail -c +$((off + 1)) "$log" | grep -Eq 'resuming$|still running$' && break
    sleep 0.5
  done
  if kill -0 "$pid" 2>/dev/null; then
    local why; why=$(tail -c +$((off + 1)) "$log" | grep 'could not' | tail -1 || true)
    die "not saved, $VM_NAME is still running: ${why:-no reply from the runner}"
  fi
  [ -s "$bundle/state.vzvmsave" ] || die "the runner exited without a saved state; see $log"
  launchctl bootout "gui/$(id -u)/$JOB" 2>/dev/null || true
  rm -rf "$snaps/$name.tmp"; mkdir -p "$snaps/$name.tmp"
  mv "$bundle/state.vzvmsave" "$snaps/$name.tmp/"
  cp -c "$bundle/disk.img" "$bundle/aux.img" "$bundle/config.json" "$snaps/$name.tmp/"
  rm -rf "$snaps/$name"; mv "$snaps/$name.tmp" "$snaps/$name"
  log "saved $VM_NAME as $name ($(tail -c +$((off + 1)) "$log" | sed -n 's/.*saved state in //p' | tail -1)); $(du -sh "$snaps/$name/state.vzvmsave" | cut -f1) of state; vm restore $name resumes it"
}

cmd_restore() {
  local name=${1:-default} log=$VM_HOME/logs/$VM_NAME-run.log off snap
  snap=$snaps/$name
  [ -s "$snap/state.vzvmsave" ] || die "no snapshot $name of $VM_NAME; saved: $(ls "$snaps" 2>/dev/null | tr '\n' ' ')"
  refuse_if_held restore
  view_stop >/dev/null 2>&1 || true
  # Stop hard: the disks are replaced anyway, and a clean shutdown costs seconds.
  if running; then
    pkill -TERM -f "$runner_pat"; sleep 0.3; pkill -TERM -f "$runner_pat" || true
    local j; for j in $(seq 40); do running || break; sleep 0.25; done
    running && die "$VM_NAME did not stop"
  fi
  launchctl bootout "gui/$(id -u)/$JOB" 2>/dev/null || true
  # Keep the current disks, to fall back to a cold boot on them.
  local f; for f in disk.img aux.img config.json; do cp -c "$bundle/$f" "$bundle/$f.pre-restore"; cp -c "$snap/$f" "$bundle/$f"; done
  local i ok=0 try hung
  for try in 1 2; do
    off=$(wc -c < "$log" 2>/dev/null || echo 0)
    boot --restore "$snap/state.vzvmsave"
    hung=1
    for i in $(seq 120); do
      tail -c +$((off + 1)) "$log" 2>/dev/null | grep -q 'restored ' && { ok=1; break; }
      tail -c +$((off + 1)) "$log" 2>/dev/null | grep -q 'could not' && { hung=0; break; }
      # launchd may not have spawned the runner yet; only its absence later counts.
      [ "$i" -gt 6 ] && ! running && { hung=0; break; }
      sleep 0.5
    done
    # A restore has hung once without an error and worked on the next try;
    # a refused one fails the same way again.
    [ "$ok" = 1 ] || [ "$hung" = 0 ] || [ "$try" = 2 ] && break
    log "no reply from the runner in 60 s; trying the restore once more"
    launchctl bootout "gui/$(id -u)/$JOB" 2>/dev/null || true; pkill -KILL -f "$runner_pat" || true
    for f in disk.img aux.img config.json; do cp -c "$snap/$f" "$bundle/$f"; done
  done
  if [ "$ok" = 1 ]; then
    for f in disk.img aux.img config.json; do rm -f "$bundle/$f.pre-restore"; done
    for i in $(seq 60); do g true 2>/dev/null && break; sleep 1; done
    # The guest wakes at save time; a snapshot restored days later would be days behind.
    g "sudo -n date -u $(date -u +%m%d%H%M%Y.%S) >/dev/null" || true
    log "restored $name ($(tail -c +$((off + 1)) "$log" | sed -n 's/.*restored [^ ]* in \([0-9.]* s\).*/\1/p' | tail -1)), up at $(ip)"
    return
  fi
  local why; why=$(tail -c +$((off + 1)) "$log" 2>/dev/null | grep 'could not' | tail -1 || true)
  [ "$hung" = 1 ] && why="no reply from the runner in 60 s"
  launchctl bootout "gui/$(id -u)/$JOB" 2>/dev/null || true
  for f in disk.img aux.img config.json; do mv "$bundle/$f.pre-restore" "$bundle/$f"; done
  log "could not restore $name (${why:-runner exited}); booting $VM_NAME cold instead"
  boot
  log "up at $(ip) (cold boot; the snapshot is kept)"
}

cmd_vsync() { g "~/vm/bin/vsync ${1:-10}"; }

cmd_shot() {
  local dir=${1:?usage: vm shot <dir> [name]} name=${2:-shot-$(date +%H%M%S)}
  mkdir -p "$dir"
  g "screencapture -x -t png ~/vm/rec/shot.png && cat ~/vm/rec/shot.png" > "$dir/$name.png"
  echo "$dir/$name.png"
}

# voxl streams the guest desktop to a browser. Its binary links x264 (GPL), so
# agent-vm never ships one: the first vm view builds the pinned version in the
# guest. voxl listens on the guest's loopback only; the host reaches it through
# an ssh forward, and --remote also serves it on the host's tailnet name.
cmd_view() {
  local control=0 remote=0
  while [ $# -gt 0 ]; do
    case $1 in
      --control) control=1 ;;
      --remote) remote=1 ;;
      stop) view_stop; return ;;
      *) die "usage: vm view [--control] [--remote] | vm view stop" ;;
    esac
    shift
  done
  running || die "$VM_NAME is not running; vm up first"
  if ! g "test -x /opt/homebrew/bin/brew"; then
    log "voxl builds with Homebrew; installing it in the guest first (about 8 min)"
    g "/bin/bash -s" < "$here/guest/brew-setup.sh" || die "Homebrew setup failed; see ~/vm/brew-setup.log in the guest"
    done_step brew || mark brew
  fi
  if [ "$(g "voxl --version 2>/dev/null | awk '{print \$NF}'")" != "$VOXL_VERSION" ]; then
    log "building voxl $VOXL_VERSION in the guest (about 10 min the first time; log ~/vm/voxl-build.log)"
    g "VOXL_VERSION=$VOXL_VERSION /bin/bash -s" < "$here/guest/voxl-build.sh" ||
      die "voxl build failed; see ~/vm/voxl-build.log in the guest"
  fi
  local tok=$bundle/voxl-token
  [ -s "$tok" ] || { (umask 077; openssl rand -hex 16 > "$tok"); }
  local hosts="" ts=""
  if [ "$remote" = 1 ]; then
    command -v tailscale >/dev/null || die "--remote needs tailscale on the host"
    ts=$(tailscale status --json | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))')
    hosts="--allowed-hosts=$ts"
  fi
  local mode; mode=$([ "$control" = 1 ] && echo control || echo watch)
  # Restart in the asked mode. Started over ssh, its screen capture counts
  # against sshd-keygen-wrapper, which provision tcc granted.
  g "umask 077; cat > ~/vm/voxl-token" < "$tok"
  g "pkill -x voxl; for i in 1 2 3 4 5; do pgrep -x voxl >/dev/null || break; sleep 1; done
     echo $mode${ts:+ remote} > ~/vm/voxl.mode
     VOXL_PASSWORD=\$(cat ~/vm/voxl-token) nohup voxl --port=6901 $([ "$control" = 1 ] || echo --read-only) \
       --files-root=\$HOME/Downloads $hosts >~/vm/voxl.log 2>&1 </dev/null &
     for i in \$(seq 20); do curl -fs -o /dev/null localhost:6901/healthz && exit 0; sleep 0.5; done
     tail -5 ~/vm/voxl.log; exit 1" || die "voxl did not start"
  view_forward
  local url="http://localhost:$VIEW_PORT/?token=$(cat "$tok")"
  if [ "$remote" = 1 ]; then
    tailscale serve --bg --https="$VIEW_PORT" "http://127.0.0.1:$VIEW_PORT" >/dev/null
    : > "$VM_HOME/run/$VM_NAME.view-remote"
    url="https://$ts:$VIEW_PORT/?token=$(cat "$tok")"
  fi
  if [ "$control" = 1 ]; then date '+%H:%M:%S' > "$hold"; else rm -f "$hold"; fi
  log "voxl ($mode${ts:+, on the tailnet}): $url"
  echo "$url"
}

# The ssh forward as a launchd job, so it outlives the caller like the guest.
view_forward() {
  local plist=$VM_HOME/run/$VIEW_JOB.plist o
  {
    cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$VIEW_JOB</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/ssh</string><string>-N</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
EOF
    for o in "${sshopts[@]}"; do printf '    <string>%s</string>\n' "$o"; done
    cat <<EOF
    <string>-L</string><string>127.0.0.1:$VIEW_PORT:127.0.0.1:6901</string>
    <string>$GUEST_USER@$(ip)</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>StandardErrorPath</key><string>$VM_HOME/logs/$VM_NAME-view.log</string>
</dict></plist>
EOF
  } > "$plist"
  job_reload "$VIEW_JOB" "$plist"
  local i; for i in $(seq 20); do curl -fs -o /dev/null "http://127.0.0.1:$VIEW_PORT/healthz" && return; sleep 0.5; done
  die "no forward on localhost:$VIEW_PORT (see $VM_HOME/logs/$VM_NAME-view.log)"
}

view_stop() {
  if [ -f "$VM_HOME/run/$VM_NAME.view-remote" ]; then
    tailscale serve --https="$VIEW_PORT" off >/dev/null 2>&1 || true
    rm -f "$VM_HOME/run/$VM_NAME.view-remote"
  fi
  launchctl bootout "gui/$(id -u)/$VIEW_JOB" 2>/dev/null || true
  rm -f "$hold"
  if running; then g "pkill -x voxl; rm -f ~/vm/voxl.mode" || true; fi
  log "view stopped"
}

c=${1:-}; shift || true
case $c in
  up|down|status|ssh|setup|install|run|quit|ad|record|shot|vsync|view|prepare|save|restore) "cmd_$c" "$@" ;;
  forward-host) cmd_forward_host "$@" ;;
  help|-h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d' | cut -c3- ;;
  *) sed -n '2,/^set -euo/p' "$0" | sed '$d' | cut -c3- >&2; exit 2 ;;
esac
