#!/usr/bin/python3 -I
"""Pull a tart image from ghcr.io so an outage or a reboot loses nothing.

`tart pull` drops a partial download when it exits, and the base image is
33 GB. This downloads each blob with curl -C - into <dir>/blobs, checks its
sha256, and retries until all are whole; run it again to resume. Then it
serves <dir> as a registry on 127.0.0.1 for one `tart pull --insecure`, and
deletes the blobs once tart has the image.

  scripts/vm/fetch-image <dir> [image]      default image:
      ghcr.io/cirruslabs/macos-golden-gate-base:latest

Prints the local image name tart now has (127.0.0.1:5917/..., FETCH_PORT),
for `tart clone`.
"""
import hashlib, http.server, json, os, shutil, subprocess, sys, threading, time
from concurrent.futures import ThreadPoolExecutor

DEFAULT = "ghcr.io/cirruslabs/macos-golden-gate-base:latest"
MANIFEST = "application/vnd.oci.image.manifest.v1+json"


def log(*a):
    print("fetch-image:", *a, file=sys.stderr, flush=True)


def token(repo):
    while True:
        try:
            out = subprocess.run(["curl", "-fsS", "--max-time", "30",
                                  f"https://ghcr.io/token?scope=repository:{repo}:pull"],
                                 capture_output=True, check=True).stdout
            return json.loads(out)["token"]
        except Exception as e:  # offline: wait it out
            log("token:", e, "- retrying in 15 s")
            time.sleep(15)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return "sha256:" + h.hexdigest()


def fetch_manifest(repo, tag, d):
    path = os.path.join(d, "manifest.json")
    if os.path.exists(path):
        return json.load(open(path))
    while True:
        r = subprocess.run(["curl", "-fsS", "--max-time", "60",
                            "-H", f"Authorization: Bearer {token(repo)}", "-H", f"Accept: {MANIFEST}",
                            "-o", path + ".part", f"https://ghcr.io/v2/{repo}/manifests/{tag}"])
        if r.returncode == 0:
            os.rename(path + ".part", path)
            return json.load(open(path))
        log("manifest: curl exit", r.returncode, "- retrying in 15 s")
        time.sleep(15)


def fetch_blob(repo, blob, d):
    digest, size = blob["digest"], blob["size"]
    final = os.path.join(d, "blobs", digest.replace(":", "-"))
    if os.path.exists(final):
        return
    part = final + ".part"
    while True:
        have = os.path.getsize(part) if os.path.exists(part) else 0
        if have < size:
            subprocess.run(["curl", "-fsSL", "--max-time", "1800", "--speed-limit", "1024", "--speed-time", "60",
                            "-C", "-", "-H", f"Authorization: Bearer {token(repo)}",
                            "-o", part, f"https://ghcr.io/v2/{repo}/blobs/{digest}"])
            have = os.path.getsize(part) if os.path.exists(part) else 0
        if have == size:
            if sha256(part) == digest:
                os.rename(part, final)
                return
            log(digest[:19], "sha256 mismatch, starting it over")
            os.remove(part)
        elif have > size:
            os.remove(part)
        else:
            time.sleep(5)


def download(repo, tag, d):
    os.makedirs(os.path.join(d, "blobs"), exist_ok=True)
    m = fetch_manifest(repo, tag, d)
    blobs = [m["config"]] + m["layers"]
    total = sum(b["size"] for b in blobs)
    done = [0]
    lock = threading.Lock()

    def one(b):
        fetch_blob(repo, b, d)
        with lock:
            done[0] += b["size"]
            log(f"{done[0] / total:6.1%} of {total / 1e9:.1f} GB")

    with ThreadPoolExecutor(4) as pool:
        list(pool.map(one, blobs))
    return m


def serve(d, repo):
    raw = open(os.path.join(d, "manifest.json"), "rb").read()
    mdigest = "sha256:" + hashlib.sha256(raw).hexdigest()

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send(self, code, ctype=None, length=0, digest=None):
            self.send_response(code)
            if ctype:
                self.send_header("Content-Type", ctype)
            if digest:
                self.send_header("Docker-Content-Digest", digest)
            self.send_header("Content-Length", str(length))
            self.end_headers()

        def handle_any(self, body):
            p = self.path.split("?")[0]
            if p in ("/v2", "/v2/"):
                return self.send(200, "application/json", 2) or (body and self.wfile.write(b"{}"))
            if p.startswith(f"/v2/{repo}/manifests/"):
                self.send(200, MANIFEST, len(raw), mdigest)
                return body and self.wfile.write(raw)
            if p.startswith(f"/v2/{repo}/blobs/"):
                f = os.path.join(d, "blobs", p.rsplit("/", 1)[1].replace(":", "-"))
                if not os.path.exists(f):
                    return self.send(404)
                self.send(200, "application/octet-stream", os.path.getsize(f), p.rsplit("/", 1)[1])
                if body:
                    with open(f, "rb") as fh:
                        shutil.copyfileobj(fh, self.wfile, 1 << 20)
                return
            self.send(404)

        def do_GET(self):
            self.handle_any(True)

        def do_HEAD(self):
            self.handle_any(False)

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", int(os.environ.get("FETCH_PORT", "5917"))), H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


def main():
    if len(sys.argv) < 2:
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    d = os.path.abspath(sys.argv[1])
    image = sys.argv[2] if len(sys.argv) > 2 else DEFAULT
    host, rest = image.split("/", 1)
    assert host == "ghcr.io", "only ghcr.io images"
    repo, tag = rest.rsplit(":", 1)
    download(repo, tag, d)
    tart = os.environ.get("TART") or shutil.which("tart") or os.path.expanduser("~/.local/bin/tart")
    srv = serve(d, repo)
    local = f"127.0.0.1:{srv.server_address[1]}/{repo}:{tag}"
    log("all blobs verified; tart pull", local)
    r = subprocess.run([tart, "pull", "--insecure", local])
    srv.shutdown()
    if r.returncode != 0:
        sys.exit(r.returncode)
    shutil.rmtree(os.path.join(d, "blobs"))
    print(local)


if __name__ == "__main__":
    main()
